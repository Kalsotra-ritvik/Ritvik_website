# Copy to .env.local for development. Never commit real values.
# Every variable here is read on the server only. Nothing secret uses the NEXT_PUBLIC_ prefix.

# --- Database (required for the admin and the CMS) -------------------------------
# A persistent PostgreSQL database, e.g. Neon / Supabase / Vercel Marketplace Postgres
# in production, or a local server in development. Without it the public site shows
# the built-in default content and the admin explains what to configure.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional: connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Tests only: a DISPOSABLE database. `npm test` and `npm run test:e2e` wipe it.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_test

# --- Site ---------------------------------------------------------------------------
# Public address, used for absolute URLs in sharing previews.
SITE_URL=https://your-domain.example

# --- Media storage ------------------------------------------------------------------
# local: files on this server's disk (development, or a server with a persistent disk).
#        Refused on Vercel, whose filesystem does not persist.
# r2:    Cloudflare R2 (S3-compatible). Default on Vercel.
STORAGE_DRIVER=local
# LOCAL_UPLOAD_DIR=.data/uploads

# Cloudflare R2 (only when STORAGE_DRIVER=r2). Create an API token with
# Object Read & Write access to one bucket.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-bucket-name
# R2_PUBLIC_BASE_URL=https://media.your-domain.example

# --- Static assets (optional) ---------------------------------------------------------
# Serve public/data/* from a CDN or bucket instead of this server (public, not secret).
# NEXT_PUBLIC_ASSET_BASE_URL=https://assets.your-domain.example

# --- Local production testing only -----------------------------------------------------
# Allows the session cookie over plain http when running `next start` on a non-localhost
# address. Never set this in a deployed environment.
# INSECURE_COOKIES=1
